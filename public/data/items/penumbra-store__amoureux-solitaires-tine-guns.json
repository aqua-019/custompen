5d61c1be4b0cafd401171f5/6d466836-12ee-4e97-ad3b-f8951f833de9/tineguns-amoureuxsolitaires-2014-4-1.jpg","alt":"Amoureux Solitaire, Tine Guns — image 4","cap":"","w":1700,"h":2160,"href":null,"fp":"0.5,0.5"}]}]}]},{"span":6,"blocks":[{"t":"text","html":"<p><strong>Artist book by Tine Guns</strong></p>\n<p>\"Two actors perform one of the most iconographic acts in the film history: the kiss.</p>\n<p>'Amoureux Solitaire' is an artist book which investigates the use of montage within a book. It's a play with the parameters of the medium. A book, like film, shares element like beginning and end, frame and the photgraphic image. But it has unique features like different reading directories, the turning of a page, the margin, the reader who has control over the time he spends to look at an image. 'Amoureux Solitaire' places itself in the grey zones between both mediums and explores new possibilities.\"</p>\n<p>80 B/W pages | Second edition /150 | Riso printed on Old Mill paper | 18,5 x 23,5 cm; 7.25 x 9.25 in | Perfect bound | co-published by 10191 &amp; Topo Copy</p>"},{"t":"row","cols":[{"span":2,"blocks":[{"t":"img","src":"https://images.squarespace-cdn.com/content/v1/55d61c1be4b0cafd401171f5/5c439624-1cd1-42a6-8aa6-15a63994bd8d/tineguns-amoureuxsolitaires-2014-5-1.jpg","alt":"Amoureux Solitaire, Tine Guns — image 5","cap":"","w":1700,"h":2160,"href":null,"fp":"0.5,0.5"}]},{"span":2,"blocks":[{"t":"img","src":"https://images.squarespace-cdn.com/content/v1/55d61c1be4b0cafd401171f5/dcc9cd6f-fdae-4211-b1a9-3048bfcf0744/tineguns-amoureuxsolitaires-2014-6-1.jpg","alt":"Amoureux Solitaire, Tine Guns — image 6","cap":"","w":1700,"h":2160,"href":null,"fp":"0.5,0.5"}]},{"span":2,"blocks":[{"t":"img","src":"https://images.squarespace-cdn.com/content/v1/55d61c1be4b0cafd401171f5/b067520e-69dc-4a95-88b2-9588bf34656e/tineguns-amoureuxsolitaires-2014-7.jpg","alt":"Amoureux Solitaire, Tine Guns — image 7","cap":"","w":1700,"h":2160,"href":null,"fp":"0.5,0.5"}]}]}]}]}]}
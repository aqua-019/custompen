1/55d61c1be4b0cafd401171f5/1668791569426-5JWYDROPM9XZ9E1GSK4Z/SophieBarbasch_Obras_08.jpg","alt":"Obras by Sophie Barbasch — image 8","fp":"0.5,0.5","size":"1500x1001"},{"src":"https://images.squarespace-cdn.com/content/v1/55d61c1be4b0cafd401171f5/1668791569311-2RK2ZEZ9H4F5XV8PUV8A/SophieBarbasch_Obras_09.jpg","alt":"Obras by Sophie Barbasch — image 9","fp":"0.5,0.5","size":"1500x1000"}],"excerpt":"","variants":[{"id":"e2f640f9-1ac6-4a9b-9eb0-cac0758852ec","label":"Special Edition","tier":null,"tierLabel":"Special Edition","price":300.0,"sale":null,"inStock":false},{"id":"81cdf2ed-1c10-4fd3-8275-ea8803002d2f","label":"Price","tier":null,"tierLabel":"Price","price":55.0,"sale":null,"inStock":false}],"soldOut":true,"from":55.0,"to":300.0,"facts":{},"order":34,"added":1663883493629,"button":null,"subscription":false,"blocks":[{"t":"text","html":"<p>This monograph is comprised of 36 photographs taken along the route of the Transnordestina, a railroad under construction in the Northeast of Brazil that ties the desert to the sea.  Traveling throughout Ceará, Piauí, and Pernambuco, Barbasch explored a country in a persistent state of flux. Obras revolves around the notion of suspension, both literal and metaphorical. The photographs are not about documenting from a stable viewpoint so much as about referencing a shifting subjectivity. They grapple with the slippery question of what it means to belong in a place and whether we can actually ever know anything simply by looking.</p>\n<p>Screen-printed softcover / Risograph / 37 pages, perfect binding / 8x9 inches / Edition of 100 with 5 APs / Special Edition of 20 with a signed silver gelatin print / Bilingual (ENG-POR) / Publisher: Penumbra Foundation / 2022 / ISBN:  978-1-7342923-8-1 </p>\n<p><strong>Please note:</strong> orders will ship Feb 2023.</p>"}]}
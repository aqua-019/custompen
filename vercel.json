{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!data/|assets/|favicon).*)", "destination": "/index.html" }],
  "redirects": [
    { "source": "/shop", "destination": "/penumbra-store", "permanent": false },
    { "source": "/membership", "destination": "/membership-main", "permanent": false },
    { "source": "/tintype", "destination": "/book-session", "permanent": false },
    { "source": "/visit", "destination": "/visitus", "permanent": false }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=600, stale-while-revalidate=86400" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
